@module kirino_std
@gl_version 330 core

@export
@code """
vec4 unpackARGB(uint c)
{
    return vec4(
        ((c >> 16u) & 255u) / 255.0,
        ((c >> 8u) & 255u) / 255.0,
        (c & 255u) / 255.0,
        ((c >> 24u) & 255u) / 255.0);
}
"""

@export
@code """
vec2 res2Ndc(vec2 res, vec2 p)
{
    return vec2(
        p.x / res.x * 2.0 - 1.0,
        1.0 - p.y / res.y * 2.0);
}
"""

@export
@code """
uint hashUint(uint x)
{
    x ^= x >> 16u;
    x *= 0x7feb352du;
    x ^= x >> 15u;
    x *= 0x846ca68bu;
    x ^= x >> 16u;
    return x;
}
"""

@export
@code """
float hash01(uint x)
{
    return float(kirino_std.hashUint(x)) * (1.0 / 4294967295.0);
}
"""

@export
@code """
float hash11(uint x)
{
    return kirino_std.hash01(x) * 2.0 - 1.0;
}
"""
